# ==============================================================================
# VEYLORA — Contoh Konfigurasi Environment Variables (v0.2)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya dengan konfigurasi lokal Anda.
# JANGAN PERNAH menyimpan kredensial atau rahasia asli ke dalam repositori Git!

# 1. Koneksi Basis Data PostgreSQL (Aplikasi Runtime - Least Privilege Role)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://veylora_app:ganti_dengan_password_aplikasi@localhost:5432/veylora_db?schema=public"

# 2. Koneksi Migrasi Basis Data (Prisma Migration & DDL - Schema Owner Role)
MIGRATION_DATABASE_URL="postgresql://postgres:ganti_dengan_password_admin@localhost:5432/veylora_db?schema=public"

# 3. Kunci Rahasia Sesi (Minimal 32 karakter untuk algoritma kriptografi HS256)
SESSION_SECRET="ganti_dengan_random_secret_minimal_32_karakter_contoh_64_hex_karakter"

# 4. Port Node / Next.js (Opsional, bawaan: 3000)
PORT=3000

