generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  settings     UserSettings?
  sessions     Session[]
  inspections  UrlInspection[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id            String   @id @default(cuid())
  displayName   String?
  notifications Boolean  @default(false)
  userId        String   @unique

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginRateLimit {
  username        String    @id
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
}

model SecurityCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  severity    String          // "Tinggi" | "Sedang" | "Rendah" | "Aman"
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  inspections UrlInspection[]
}

model UrlInspection {
  id          String           @id @default(cuid())
  url         String
  domain      String
  status      String           // "Mencurigakan" | "Perlu Diperiksa" | "Aman"
  reasons     String[]         @default([])
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  categoryId  Int
  category    SecurityCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@index([status])
}

